# Disposable diagnostic image for docs/reference-timing.md: the Gaia worker image plus timm, pinned so nothing already in the image changes.
FROM docker.yasp.ai/yasp-eval/nvidia:1.11.0
RUN /opt/conda/bin/pip list --format=freeze > /tmp/constraints.txt \
    && /opt/conda/bin/pip install --no-cache-dir -c /tmp/constraints.txt timm \
    && rm /tmp/constraints.txt
